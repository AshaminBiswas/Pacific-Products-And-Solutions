{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/gone",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gallery/",
      "destination": "/gallery",
      "permanent": true
    },
    {
      "source": "/download/",
      "destination": "/download",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/products/",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/solutions/",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/testimonials/",
      "destination": "/testimonials",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/brochure/",
      "destination": "/brochure",
      "permanent": true
    },
    {
      "source": "/products/kids-toilet",
      "destination": "/products/kids-cubicles",
      "permanent": true
    },
    {
      "source": "/products/kids-cubicle",
      "destination": "/products/kids-cubicles",
      "permanent": true
    },
    {
      "source": "/kids-cubicle",
      "destination": "/products/kids-cubicles",
      "permanent": true
    },
    {
      "source": "/cubicles",
      "destination": "/products/restroom-cubicles",
      "permanent": true
    },
    {
      "source": "/lockers",
      "destination": "/products/lockers",
      "permanent": true
    },
    {
      "source": "/urinal-partitions",
      "destination": "/products/urinal-partitions",
      "permanent": true
    },
    {
      "source": "/products/restroom-cubicles/plarina-wave",
      "destination": "/products/restroom-cubicles/platina-wave",
      "permanent": true
    },
    {
      "source": "/products/restroom-cubicles/cubicle-platina-wave",
      "destination": "/products/restroom-cubicles/platina-wave",
      "permanent": true
    },
    {
      "source": "/products/plarina-wave",
