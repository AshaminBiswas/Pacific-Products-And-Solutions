      "permanent": true
    },
    {
      "source": "/products/platina-wave",
      "destination": "/products/restroom-cubicles/platina-wave",
      "permanent": true
    },
    {
      "source": "/configure-cubicle",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/design-studio",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/products/restroom-cubicles/saffron",
      "destination": "/products/restroom-cubicles/cubicle-saffron",
      "permanent": true
    },
    {
      "source": "/products/restroom-cubicles/sky-light",
      "destination": "/products/restroom-cubicles/cubicle-skylight",
      "permanent": true
    },
    {
      "source": "/locations/mumbai",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/locations/bangalore",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/locations/ahmedabad",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/locations/uae",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/nvidia/:path*",
      "destination": "/api/nvidia"
    },
    {
      "source": "/api/gone",
      "destination": "/api/gone"
    },
    {
      "source": "/(.*)/([0-9]{4,10})",
      "destination": "/api/gone"
    },
    {
      "source": "/(.*)/([0-9]{4,10})/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/category/:path*",
      "destination": "/api/gone"
    },
    {
      "source": "/tag/:path*",
      "destination": "/api/gone"
    },
    {
      "source": "/author/:path*",
      "destination": "/api/gone"
    },
    {
      "source": "/feed/:path*",
      "destination": "/api/gone"
    },
    {
      "source": "/comments/:path*",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/(.*)\\.php",
      "destination": "/api/gone"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "goods"
        }
      ],
      "destination": "/api/gone"
    },
    {
